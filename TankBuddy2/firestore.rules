rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user data: only verified owner e-mail(s). Add family e-mails to the list below.
    function owner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['milan.blairon@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if owner();
    }
  }
}
